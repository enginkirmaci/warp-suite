{
    // Open warp-suite itself and press F5; each config builds only its app
    // (the matching task passes -p) and runs the binary from the shared target
    // dir (.cargo/config.toml: .build/target).
    //
    // Two configs per app because "type" cannot be platform-specific in
    // launch.json: Linux uses webfreak.debug's gdb adapter (CodeLLDB wedges at
    // the NVIDIA Vulkan ICD dlopen under its solib handler), Windows uses the
    // C/C++ extension's cppvsdbg. F5 reuses the last-selected config per
    // machine, so each machine only ever sees its own entry after the first
    // pick. snapit is the exception: it is Windows-only (apps.toml
    // linux_skip = true; the engine is cfg(windows)), so it has a cppvsdbg
    // config and no gdb one — on Linux the binary is a stub that only reports
    // the engine is Windows-only.
    //
    // gdb uses non-standard field names: "target" (not "program") and a string
    // "arguments" (not "args") — a missing "target" crashes the adapter with
    // ERR_INVALID_ARG_TYPE.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rust: warp-station (Linux — gdb)",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/.build/target/debug/warp-station",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo build (warp-station)"
        },
        {
            "name": "Rust: warp-agent (Linux — gdb)",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/.build/target/debug/warp-agent",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo build (warp-agent)"
        },
        {
            "name": "Rust: warp-notes (Linux — gdb)",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/.build/target/debug/warp-notes",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo build (warp-notes)"
        },
        {
            "name": "Rust: warp-station (Windows — cppvsdbg)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build/target/debug/warp-station.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "cargo build (warp-station)"
        },
        {
            "name": "Rust: warp-agent (Windows — cppvsdbg)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build/target/debug/warp-agent.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "cargo build (warp-agent)"
        },
        {
            "name": "Rust: warp-notes (Windows — cppvsdbg)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build/target/debug/warp-notes.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "cargo build (warp-notes)"
        },
        {
            "name": "Rust: snapit (Windows — cppvsdbg)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/.build/target/debug/warp-snapit.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "cargo build (snapit)"
        }
    ]
}
