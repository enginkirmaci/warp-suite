{
    // One config: "type" cannot be platform-specific in launch.json, and
    // CodeLLDB (vadimcn.vscode-lldb) wedges at the NVIDIA Vulkan ICD dlopen
    // under its solib handler, so webfreak.debug's gdb adapter is the one that
    // works on this machine. Windows debugging would need a cppvsdbg entry
    // added on that machine.
    //
    // webfreak.debug uses non-standard field names: "target" (not "program")
    // and "arguments" (a string, not "args") — a missing "target" crashes the
    // adapter with ERR_INVALID_ARG_TYPE.
    // Binaries come from the suite's shared target dir (.cargo/config.toml at
    // the repo root sets .build/target); a CARGO_TARGET_DIR env var would win
    // over it and move them, so keep this path in step with the build.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rust: warp-agent (gdb)",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/../../.build/target/debug/warp-agent",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo build (warp-agent)"
        }
    ]
}
